# Primary MongoDB database (Atlas or a MongoDB replica set)
# Keep the URI private. On a new machine, the same URI/database reopens the drive.
MONGODB_URI=<mongodb-connection-uri>
MONGODB_DATABASE=tgdrive
# Docker Compose generates and persists this AES-256 recovery key when blank.
# Download Save Recovery Key in Storage & Backups and keep it off this machine.
# Manual installs must generate it: python -c "import secrets; print(secrets.token_hex(32))"
# Restore/migration: supply the ORIGINAL key, never generate a replacement.
MONGODB_BACKUP_KEY=
# Encrypted full MongoDB backup to Telegram; independent of upload completion.
MONGODB_BACKUP_SECONDS=3600

# Required Telegram credentials
API_ID=<telegram-api-id>
API_HASH=<telegram-api-hash>
BOT_TOKENS=<bot-token>[,<additional-bot-token>]
STORAGE_CHANNEL=<private-channel-id>
# Use a dedicated PRIVATE channel with auto-delete OFF. Every storage bot must
# be an administrator with Post Messages + Delete Messages. MongoDB does not pin.
# Do not manually add/edit/delete/forward messages inside this storage channel.
# Legacy SQLite recovery only; unused by MongoDB.
# DATABASE_BACKUP_MSG_ID=

# Required owner password, at least 12 characters; choose a unique long password.
ADMIN_PASSWORD=<strong-admin-password>
# Alternatively supply an Argon2id hash generated by the owner-password CLI.
# Leave ADMIN_PASSWORD empty when using a hash. Single quotes protect $ in .env.
# ADMIN_PASSWORD_HASH='<generated-argon2id-hash>'
# Compose generates and persists this when blank; manual installs need >=32 chars.
SESSION_SECRET=

# Optional Premium Telethon sessions for preferred upload/download speed.
# Bot-only logical files can span ordered messages within the configured staging/file limit.
# Old Pyrogram/Kurigram session strings are incompatible; authorize fresh sessions.
STRING_SESSIONS=

# Optional Telegram bot-mode interface
# MAIN_BOT_TOKEN requires a nonempty list of positive numeric Telegram user IDs.
# Use a private chat with the bot; choose its upload folder on the website.
MAIN_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Optional website origin for bot settings links; does not publish the app.
# PUBLIC_URL=https://drive.example.com
# Optional website origin for bot /set_folder links before saving settings online.
# Example: https://drive.example.com (no password, query or fragment).
PUBLIC_URL=

# Runtime behavior
# Public demo: keep Configuration and Management visible but read-only.
# File features stay enabled; normal owner login is still required.
DEMO_MODE=false
# Legacy SQLite checkpoint interval; unused by MongoDB.
# DATABASE_BACKUP_TIME=60
SLEEP_THRESHOLD=60
# MAX_FILE_SIZE=2000000000
# HTTP localhost only: false. Hosted Compose always enforces true (requires HTTPS).
COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
# Startup never initializes a missing catalog.
# Use python -m tgdrive init for a new empty MongoDB database.
INITIALIZE_EMPTY_DRIVE=false
LOG_LEVEL=INFO
DATA_DIR=data
CACHE_DIR=cache
# Docker Compose host binding; keep loopback behind a local HTTPS reverse proxy.
BIND_ADDRESS=127.0.0.1
PORT=8000
# Local Compose stays stopped after reboot; use unless-stopped for automatic start.
# Hosted Compose defaults to unless-stopped. Leave unset to use the selected mode.
# TGDRIVE_RESTART_POLICY=no
# Uvicorn: trust only the real reverse proxy's source IP/network. Never use *
# when the app port can also be reached directly by untrusted clients.
# Coolify discovers its proxy automatically; local Compose trusts loopback only.
# A custom server reverse proxy may need its exact Docker gateway/source IP here.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Remote URL upload safeguards
ALLOW_PRIVATE_REMOTE_URLS=false
REMOTE_CONNECT_TIMEOUT=20
REMOTE_READ_TIMEOUT=120
REMOTE_TOTAL_TIMEOUT=21600
REMOTE_MAX_REDIRECTS=5
# Local I/O and receipt-handler bound; Telegram uploads use per-bot slots.
MAX_CONCURRENT_TRANSFERS=2
# Initial value; Configuration → Transfer limits saves an override without a restart (1–4).
TELEGRAM_UPLOADS_PER_BOT=1
TRANSFER_TTL_SECONDS=3600

# Persistent upload staging and bounded streaming
# Upload staging: 16 GiB maximum; separate from the disposable media cache.
STAGING_BUDGET_BYTES=17179869184
# Staging free-space reserve: 1 GiB, independent of CACHE_MIN_FREE_BYTES.
MIN_FREE_BYTES=1073741824
UPLOAD_SESSION_TTL_SECONDS=86400
# Obsolete compatibility value; origin admission controls load, not viewer count.
# MAX_CONCURRENT_STREAMS=4

# Live controls: Configuration → Cache settings / Transfer limits / Timezone.
# Saved dashboard preferences in MongoDB take precedence over startup values.
# Included Compose definitions forward these values; no additions are required.
TIMEZONE=Asia/Kolkata
# RAM media budget: 256 MiB; available memory may lower it. Idle expiry: 10 minutes.
CACHE_MEMORY_BYTES=268435456
# Disk media budget: 10 GiB, allocated on demand rather than reserved in advance.
CACHE_DISK_BYTES=10737418240
# Cache-only free-space floor: 1 GiB. Upload staging uses MIN_FREE_BYTES separately.
CACHE_MIN_FREE_BYTES=1073741824
# Disk idle retention: 24 hours; reuse refreshes expiry, pressure may evict sooner.
CACHE_TTL_SECONDS=86400
# Delivered sequential playback/download bytes can trigger background preparation.
# Manual Prepare remains available when automatic preloading is false.
AUTO_PRELOAD=true
# Combined manual + automatic jobs; foreground demand takes priority.
PRELOAD_MAX_JOBS=2
# Upload-part requests per document, also bounded by the shared account limits.
TELEGRAM_UPLOAD_PIPELINE=4
# Shared concurrent Telegram RPCs per account (upload, download, media metadata).
TELEGRAM_REQUEST_LIMIT=8
# Per-account application pacing ceiling, not an entitlement from Telegram.
TELEGRAM_PARTS_PER_SECOND=48
# Concurrent origin upload/download operations per account, not cached viewers.
TELEGRAM_MEDIA_PER_BOT=3
# Waiting origin operations across the installation, not a whole-file/viewer cap.
TELEGRAM_MAX_QUEUE=256
# All accounts use at most 2000 MiB per document; 0 also uses 2000 MiB.
# Lower values split future uploads sooner; Premium does not raise this cap.
UPLOAD_SPLIT_MIB=2000
