# Required values for a new drive. Setup: docs/setup.md
MONGODB_URI=<mongodb-connection-uri>

# Telegram application credentials and private storage channel.
API_ID=<telegram-api-id>
API_HASH=<telegram-api-hash>
BOT_TOKENS=<bot-token>
STORAGE_CHANNEL=<private-channel-id>

# Unique owner password: at least 12 characters.
ADMIN_PASSWORD=<strong-admin-password>

# Optional settings and defaults: docs/reference.md#configuration
