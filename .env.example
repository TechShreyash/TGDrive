# Primary MongoDB database (Atlas or a MongoDB replica set)
# Keep the URI private. On a new machine, the same URI/database reopens the drive.
MONGODB_URI=<mongodb-connection-uri>
MONGODB_DATABASE=tgdrive
# AES-256 recovery key: generate with python -c "import secrets; print(secrets.token_hex(32))"
# Keep a copy outside this installation; needed if MongoDB itself is lost.
MONGODB_BACKUP_KEY=<64-random-hex-characters>
# Encrypted full MongoDB backup to Telegram; independent of upload completion.
MONGODB_BACKUP_SECONDS=3600

# Required Telegram credentials
API_ID=<telegram-api-id>
API_HASH=<telegram-api-hash>
BOT_TOKENS=<bot-token>[,<additional-bot-token>]
STORAGE_CHANNEL=<private-channel-id>
# Storage bots need channel read/post/delete access; MongoDB backups do not pin messages.
# Legacy SQLite recovery only; unused by MongoDB.
# DATABASE_BACKUP_MSG_ID=

# Required web authentication secrets (use unique random values)
ADMIN_PASSWORD=<strong-admin-password>
# Alternatively supply an Argon2id hash generated by the owner-password CLI.
# ADMIN_PASSWORD_HASH='<generated-argon2id-hash>'
SESSION_SECRET=<at-least-32-random-characters>

# Optional Premium Telethon sessions for larger single-message uploads and preferred reads.
# Bot-only logical files can span ordered messages within the configured staging/file limit.
# Old Pyrogram/Kurigram session strings are incompatible; authorize fresh sessions.
STRING_SESSIONS=

# Optional Telegram bot-mode interface
MAIN_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Runtime behavior
# Legacy SQLite checkpoint interval; unused by MongoDB.
# DATABASE_BACKUP_TIME=60
SLEEP_THRESHOLD=60
# MAX_FILE_SIZE=2000000000
COOKIE_SECURE=true
SESSION_TTL_SECONDS=86400
# Startup never initializes a missing catalog.
# Use python -m tgdrive init for a new empty MongoDB database.
INITIALIZE_EMPTY_DRIVE=false
LOG_LEVEL=INFO
DATA_DIR=data
CACHE_DIR=cache
# Docker Compose host binding; keep loopback behind a local HTTPS reverse proxy.
BIND_ADDRESS=127.0.0.1
PORT=8000
# Uvicorn: trust only the real reverse proxy's source IP/network. Never use *
# when the app port can also be reached directly by untrusted clients.
FORWARDED_ALLOW_IPS=127.0.0.1

# Remote URL upload safeguards
ALLOW_PRIVATE_REMOTE_URLS=false
REMOTE_CONNECT_TIMEOUT=20
REMOTE_READ_TIMEOUT=120
REMOTE_TOTAL_TIMEOUT=21600
REMOTE_MAX_REDIRECTS=5
# Local I/O and receipt-handler bound; Telegram uploads use per-bot slots.
MAX_CONCURRENT_TRANSFERS=2
# Initial value; Settings → Uploads saves an override without a restart (1–4).
TELEGRAM_UPLOADS_PER_BOT=1
TRANSFER_TTL_SECONDS=3600

# Persistent upload staging and bounded streaming
STAGING_BUDGET_BYTES=17179869184
MIN_FREE_BYTES=1073741824
UPLOAD_SESSION_TTL_SECONDS=86400
# Legacy compatibility value; origin admission now controls load, not viewer count.
MAX_CONCURRENT_STREAMS=4

# Live operator settings are also available in Settings > Performance.
# After the first dashboard save, performance-preferences.json takes precedence.
TIMEZONE=Asia/Kolkata
CACHE_MEMORY_BYTES=268435456
CACHE_DISK_BYTES=10737418240
CACHE_MIN_FREE_BYTES=1073741824
CACHE_TTL_SECONDS=86400
AUTO_PRELOAD=True
PRELOAD_MAX_JOBS=2
TELEGRAM_UPLOAD_PIPELINE=4
TELEGRAM_REQUEST_LIMIT=8
TELEGRAM_PARTS_PER_SECOND=24
TELEGRAM_MEDIA_PER_BOT=3
TELEGRAM_MAX_QUEUE=256
# 0 uses the safe maximum; lower values split future uploads sooner.
UPLOAD_SPLIT_MIB=2000
